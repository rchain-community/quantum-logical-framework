# Python
__pycache__/
*.py[cod]

# downloaded PDB structures (contact_order_regression.py --fetch)
.pdb_cache/

# Lean build tree / Mathlib cache — a symlink to the Transcend SSD when mounted.
# CI does `rm -rf .lake` on every run; it must never be committed.
# No trailing slash: .lake is a symlink here, not a directory.
.lake

# Local runtime dir for  qucalc_search.py --serve  (pid/log)
.run

# Claude Code scheduled-tasks lock — per-session runtime state, churns every
# session and was accidentally committed once (bb7b40a); never track it.
.claude/*.lock

# Pantheon+ release, downloaded by fit_interacting_vacuum.py (33 MB covariance)
data/pantheonplus/
